http:
  middlewares:
    path-strip-v3:
      stripPrefix:
        prefixes:
         - "/v3"    
    dev-host-headers:
      headers:
        customRequestHeaders:
          host: "localhost:5000"
        customResponseHeaders:
          access-control-allow-origin: ""
          host: "localhost:5000"
    error-handler:
      errors:
        status:
          - "501-599"
        service: pods-service
        query: "/error-handler/{status}"
    not-found-rewrite:
      replacePathRegex:
        regex: ".*"
        replacement: "/pod-not-found"

    {% for pname, pdata in http_proxy_info.items() -%}
    {% if pdata.tapis_auth -%}
    tapis-auth-{{ pname }}:
      forwardAuth:
        address: {{ pdata.auth_url }}
        {% if pdata.tapis_auth_response_headers -%}
        authResponseHeaders: # headers from auth check
          {% for header in pdata.tapis_auth_response_headers -%}
          - "{{ header }}"
          {% endfor %}
        {% endif -%}
        #addAuthCookiesToResponse: # headers from initial request
    {% endif -%}
    {% endfor %}

    {% for pname, pdata in http_proxy_info.items() -%}
    {% if pdata.access_gate -%}
    tapis-gate-{{ pname }}:
      forwardAuth:
        address: {{ pdata.gate_url }}
        authResponseHeaders: # forward matched code label to the pod so traffic logs attribute the visitor
          - "X-Tapis-Gate-Code"
    {% endif -%}
    {% endfor %}

    {% for pname, pdata in http_proxy_info.items() -%}
    {% if pdata.cors_allow_origins -%}
    tapis-cors-{{ pname }}:
      headers:
          accessControlAllowOriginList:
            {% for origin in pdata.cors_allow_origins -%}
            - "{{ origin }}"
            {% endfor %}
          {% if pdata.cors_allow_methods -%}
          accessControlAllowMethods:
            {% for method in pdata.cors_allow_methods -%}
            - "{{ method }}"
            {% endfor %}
          {% endif -%}
          {% if pdata.cors_allow_headers -%}
          accessControlAllowHeaders:
            {% for header in pdata.cors_allow_headers -%}
            - "{{ header }}"
            {% endfor %}
          {% endif -%}
          {% if pdata.cors_allow_credentials is not none -%}
          accessControlAllowCredentials: {{ pdata.cors_allow_credentials | lower }}
          {% endif -%}
          {% if pdata.cors_max_age is not none -%}
          accessControlMaxAge: {{ pdata.cors_max_age }}
          {% endif -%}
          addVaryHeader: false
    {% endif -%}
    {% endfor %}

    {% for pname, pdata in http_proxy_info.items() -%}
    {% if pdata.ip_allow_list -%}
    tapis-ipallowlist-{{ pname }}:
      ipAllowList:
        sourceRange:
          {% for ip in pdata.ip_allow_list -%}
          - "{{ ip }}"
          {% endfor %}
    {% endif -%}
    {% endfor %}

    {% for pname, pdata in http_proxy_info.items() -%}
    {% if pdata.splash_mode is defined and pdata.splash_mode -%}
    tapis-splash-{{ pname }}:
      replacePathRegex:
        regex: ".*"
        replacement: "/pod-splash"
    {% endif -%}
    {% endfor %}

    {% for pname, pdata in http_proxy_info.items() -%}
    {% if pdata.proxy_compression is defined and pdata.proxy_compression -%}
    tapis-compress-{{ pname }}:
      compress:
        encodings:
          {% for enc in pdata.proxy_compression_encodings -%}
          - "{{ enc }}"
          {% endfor %}
        {% if pdata.proxy_compression_excluded_content_types -%}
        excludedContentTypes:
          {% for ct in pdata.proxy_compression_excluded_content_types -%}
          - "{{ ct }}"
          {% endfor %}
        {% endif -%}
        minResponseBodyBytes: {{ pdata.proxy_compression_min_response_body_bytes }}
    {% endif -%}
    {% endfor %}

  routers:
    dashboard:
      rule: (PathPrefix(`/api`) || PathPrefix(`/dashboard`))
      service: api@internal

    pods-service:
      rule: "PathPrefix(`/v3/pods`)"
      middlewares:
       - "path-strip-v3"
       #- "dev-host-headers" # Only for dev to allow localhost access
       - "error-handler"
      service: pods-service

    {% for pname, pdata in http_proxy_info.items() -%}
    {% set has_auth_exclusions = pdata.tapis_auth and (pdata.tapis_auth_excluded_paths or pdata.tapis_auth_excluded_path_regex) -%}
    {{ pname }}:
      entryPoints:
       - web
      rule: "Host(`{{ pdata.url }}`){% if pdata.custom_domain and pdata.custom_domain_verified %} || Host(`{{ pdata.custom_domain }}`){% endif %}"
      {% if pdata.splash_mode or pdata.tapis_auth or pdata.access_gate or pdata.cors_allow_origins or pdata.ip_allow_list or (pdata.proxy_compression is defined and pdata.proxy_compression) -%}
      middlewares:
        {% if pdata.splash_mode is defined and pdata.splash_mode -%}
        - "tapis-splash-{{ pname }}"
        {% endif -%}
        {% if pdata.ip_allow_list -%}
        - "tapis-ipallowlist-{{ pname }}"
        {% endif -%}
        {% if pdata.cors_allow_origins -%}
        - "tapis-cors-{{ pname }}"
        {% endif -%}
        {% if pdata.access_gate and not (pdata.splash_mode is defined and pdata.splash_mode) -%}
        - "tapis-gate-{{ pname }}"
        {% endif -%}
        {% if pdata.tapis_auth and not (pdata.splash_mode is defined and pdata.splash_mode) -%}
        - "tapis-auth-{{ pname }}"
        {% endif -%}
        {% if pdata.proxy_compression is defined and pdata.proxy_compression and not (pdata.splash_mode is defined and pdata.splash_mode) -%}
        - "tapis-compress-{{ pname }}"
        {% endif -%}
      {% endif %}
      service: "{{ pname }}"
      {% if has_auth_exclusions -%}
      priority: 1
      {% endif -%}
      tls:
        certResolver: tlsletsencrypt

    {% if has_auth_exclusions -%}
    {{ pname }}-noauth:
      entryPoints:
       - web
      rule: >-
        (Host(`{{ pdata.url }}`){% if pdata.custom_domain and pdata.custom_domain_verified %} || Host(`{{ pdata.custom_domain }}`){% endif %}) && (
        {%- set rule_parts = [] -%}
        {%- for path in pdata.tapis_auth_excluded_paths -%}
          {%- set _ = rule_parts.append('PathPrefix(`' + path + '`)') -%}
        {%- endfor -%}
        {%- for regex in pdata.tapis_auth_excluded_path_regex -%}
          {%- set _ = rule_parts.append('PathRegexp(`' + regex + '`)') -%}
        {%- endfor -%}
        {{ rule_parts | join(' || ') }}
        )
      {% if pdata.cors_allow_origins or pdata.ip_allow_list or (pdata.proxy_compression is defined and pdata.proxy_compression) -%}
      middlewares:
        {% if pdata.ip_allow_list -%}
        - "tapis-ipallowlist-{{ pname }}"
        {% endif -%}
        {% if pdata.cors_allow_origins -%}
        - "tapis-cors-{{ pname }}"
        {% endif -%}
        {% if pdata.proxy_compression is defined and pdata.proxy_compression -%}
        - "tapis-compress-{{ pname }}"
        {% endif %}
      {% endif %}
      service: "{{ pname }}"
      priority: 100
      tls:
        certResolver: tlsletsencrypt
    {% endif -%}

    {% endfor %}

    catch-all-error-handler:
      rule: "PathPrefix(`/*`)"
      middlewares:
       - "not-found-rewrite"
      service: pods-service

  services:
    pods-service:
      loadBalancer:
        servers:
         - url: http://pods-api:8000

    {% for pname, pdata in http_proxy_info.items() -%}
    {{ pname }}:
      loadBalancer:
        servers:
         - url: http://{{ pdata.k8_service }}:{{ pdata.routing_port }}
    {% endfor %}

tcpServersTransport:
  dialTimeout: 180s
  dialKeepAlive: 180s

{% if tcp_proxy_info or postgres_proxy_info -%}
tcp:
  middlewares:
    {% for pname, pdata in tcp_proxy_info.items() -%}
    {% if pdata.ip_allow_list -%}
    tapis-ipallowlist-{{ pname }}:
      ipAllowList:
        sourceRange:
          {% for ip in pdata.ip_allow_list -%}
          - "{{ ip }}"
          {% endfor %}
    {% endif -%}
    {% endfor %}


  routers:{% endif %}
    {% for pname, pdata in tcp_proxy_info.items() -%}
    {{ pname }}:
      entryPoints:
       - web
      rule: "HostSNI(`{{ pdata.url }}`)"
      {% if pdata.ip_allow_list -%}
      middlewares:
       - "tapis-ipallowlist-{{ pname }}"
      {% endif -%}
      service: "{{ pname }}"
      tls:
        certResolver: tlsletsencrypt
    {% endfor %}
    {% for pname, pdata in postgres_proxy_info.items() -%}
    {{ pname }}:
      rule: "HostSNI(`{{ pdata.url }}`)"
      {% if pdata.ip_allow_list -%}
      middlewares:
       - "tapis-ipallowlist-{{ pname }}"
      {% endif -%}
      service: "{{ pname }}"
      tls:
        certResolver: tlsletsencrypt
        passthrough: true
    {% endfor %}

  {% if tcp_proxy_info or postgres_proxy_info -%}
  services:{% endif %}
    {% for pname, pdata in tcp_proxy_info.items() -%}
    {{ pname }}:
      loadBalancer:
        servers:
         - address: {{ pdata.k8_service }}:{{ pdata.routing_port }}
    {% endfor %}
    {% for pname, pdata in postgres_proxy_info.items() -%}
    {{ pname }}:
      loadBalancer:
        servers:
         - address: {{ pdata.k8_service }}:{{ pdata.routing_port }}
    {% endfor %}
