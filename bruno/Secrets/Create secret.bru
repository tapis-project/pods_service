meta {
  name: Create secret
  type: http
  seq: 4
}

post {
  url: {{base_url}}/pods/secrets
  body: json
  auth: none
}

headers {
  X-Tapis-Token: {{X-Tapis-Token}}
  Content-Type: application/json
}

body:json {
  {
    "secret_id": "mysecretid",
    "secret_value": "mysecretvalue",
    "description": "My secret description",
    "readable": false
  }
}
