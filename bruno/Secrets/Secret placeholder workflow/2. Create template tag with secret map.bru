meta {
  name: 2. Create template tag with secret map
  type: http
  seq: 2
}

post {
  url: {{base_url}}/pods/templates/mytemplate/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
    "pod_definition": {
      "description": "Template tag with secret placeholders",
      "image": "postgres:15",
      "secret_map": {
        "DB_PASSWORD": "${:?Database password - REQUIRED}",
        "DB_HOST": "${localhost:?Database hostname - optional, defaults to localhost}"
      },
      "environment_variables": {
        "POSTGRES_PASSWORD": "${pods:secrets:DB_PASSWORD}",
        "POSTGRES_HOST": "${pods:secrets:DB_HOST}"
      }
    },
    "tag": "v1",
    "commit_message": "Initial tag with secret placeholders"
  }
}
