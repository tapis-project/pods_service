meta {
  name: 3. Create pod with secret map
  type: http
  seq: 3
}

post {
  url: {{base_url}}/pods
  body: json
  auth: none
}

headers {
  X-Tapis-Token: {{X-Tapis-Token}}
  Content-Type: application/json
}

body:json {
  {
    "pod_id": "{{pod_id}}",
    "template": "mytemplate:v1",
    "secret_map": {
      "DB_PASSWORD": "mysecurepassword"
    }
  }
}
