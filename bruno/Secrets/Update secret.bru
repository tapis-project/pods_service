meta {
  name: Update secret
  type: http
  seq: 5
}

put {
  url: {{base_url}}/pods/secrets/mysecretid
  body: json
  auth: none
}

headers {
  X-Tapis-Token: {{X-Tapis-Token}}
  Content-Type: application/json
}

body:json {
  {
    "secret_value": "newsecretvalue",
    "description": "Updated description",
    "readable": false
  }
}
