meta {
  name: stacks: create
  type: http
  seq: 1
}

post {
  url: {{base_url}}/pods/stacks
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
    "stack_id": "{{stack_id}}",
    "description": "n8n automation stack",
    "restart_policy": "ordered"
  }
}

docs {
  Flat, tenant-unique `stack_id` (like pod_id/volume_id). Creator is seeded `{username}:ADMIN`.
  `restart_policy`: `ordered` (honor each member's `depends_on`) or `parallel` (act on all at once).
}
