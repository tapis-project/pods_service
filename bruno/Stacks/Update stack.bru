meta {
  name: Update stack
  type: http
  seq: 4
}

put {
  url: {{base_url}}/pods/stacks/{{stack_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
    "restart_policy": "parallel",
    "description": "updated description"
  }
}

docs {
  Only `description` / `restart_policy` are editable here. Membership is changed via join/leave,
  never a field edit.
}
