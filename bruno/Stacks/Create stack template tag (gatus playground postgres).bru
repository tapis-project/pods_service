meta {
  name: tag: gatus playground postgres (stack)
  type: http
  seq: 23
}

post {
  url: {{base_url}}/pods/templates/gatus/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
    "kind": "stack",
    "stack_definition": {
      "restart_policy": "ordered",
      "secret_map": {
        "PG_PASSWORD": "${pods:random:32}"
      },
      "members": [
        {
          "name": "db",
          "image": "postgres:17-alpine",
          "description": "Postgres 17 for durable gatus playground history. local_only - never exposed outside the cluster.",
          "ready_condition": "ready",
          "time_to_stop_default": -1,
          "networking": {
            "default": {
              "protocol": "local_only",
              "port": 5432,
              "tapis_auth": false
            }
          },
          "healthchecks": {
            "readiness": {
              "exec_command": [
                "pg_isready",
                "-U",
                "gatus",
                "-d",
                "gatus"
              ],
              "initial_delay_seconds": 5,
              "period_seconds": 5
            },
            "networking_requires_ready": false
          },
          "environment_variables": {
            "POSTGRES_DB": "gatus",
            "POSTGRES_USER": "gatus",
            "POSTGRES_PASSWORD": "${stack:secrets:PG_PASSWORD}",
            "PGDATA": "/var/lib/postgresql/data/pgdata"
          },
          "resources": {
            "cpu_request": 250,
            "cpu_limit": 2000,
            "mem_request": 256,
            "mem_limit": 2048
          }
        },
        {
          "name": "app",
          "image": "twinproduction/gatus:v5.36.0",
          "description": "Gatus playground with postgres storage - the example endpoints + httpbin suite, with check history that survives app restarts.",
          "depends_on": [
            "db"
          ],
          "time_to_stop_default": -1,
          "environment_variables": {
            "GATUS_DB_HOST": "${stack:db:host}",
            "GATUS_DB_PORT": "5432",
            "GATUS_DB_USER": "gatus",
            "GATUS_DB_NAME": "gatus",
            "GATUS_DB_PASSWORD": "${stack:secrets:PG_PASSWORD}"
          },
          "volume_mounts": {
            "/config/config.yaml": {
              "type": "ephemeral",
              "read_only": false,
              "config_permissions": "0644",
              "config_update_mode": "always",
              "config_content": "# ============================================================================\n# Gatus playground (postgres) \u2014 the playground config with DURABLE history.\n# storage.type: postgres, connection assembled from GATUS_DB_* env (stack refs).\n# key=value DSN (not postgres://) because the random password may contain @ # %.\n# ============================================================================\n\nmetrics: true\n\nstorage:\n  type: postgres\n  path: \"host=${GATUS_DB_HOST} port=${GATUS_DB_PORT} user=${GATUS_DB_USER} password='${GATUS_DB_PASSWORD}' dbname=${GATUS_DB_NAME} sslmode=disable\"\n\nui:\n  title: \"Gatus Lab\"\n  header: \"Gatus Lab (durable)\"\n\nconcurrency: 3\n\nendpoints:\n  - name: twin-health\n    group: examples\n    url: \"https://twin.sh/health\"\n    interval: 1m\n    conditions:\n      - \"[STATUS] == 200\"\n      - \"[BODY].status == UP\"\n\n  - name: github-api\n    group: examples\n    url: \"https://api.github.com\"\n    interval: 5m\n    conditions:\n      - \"[STATUS] == 200\"\n      - \"[RESPONSE_TIME] < 1500\"\n\n  - name: example-dot-com\n    group: examples\n    url: \"https://example.com/\"\n    interval: 5m\n    conditions:\n      - \"[STATUS] == 200\"\n\nsuites:\n  - name: token-reuse-demo\n    group: api-tests\n    interval: 2m\n    timeout: 30s\n    endpoints:\n      - name: mint-token\n        url: \"https://httpbin.org/uuid\"\n        method: GET\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"len([BODY].uuid) > 0\"\n        store:\n          token: \"[BODY].uuid\"\n\n      - name: use-token\n        url: \"https://httpbin.org/bearer\"\n        method: GET\n        headers:\n          Authorization: \"Bearer [CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].authenticated == true\"\n          - \"[BODY].token == [CONTEXT].token\"\n"
            }
          },
          "networking": {
            "default": {
              "protocol": "http",
              "port": 8080,
              "tapis_auth": true,
              "tapis_auth_allowed_users": [
                "*"
              ],
              "tapis_auth_return_path": "/"
            }
          },
          "healthchecks": {
            "readiness": {
              "http_get_path": "/health",
              "http_get_port": 8080,
              "initial_delay_seconds": 5,
              "period_seconds": 10
            },
            "liveness": {
              "http_get_path": "/health",
              "http_get_port": 8080,
              "initial_delay_seconds": 30,
              "period_seconds": 15
            },
            "networking_requires_ready": true
          }
        }
      ]
    },
    "tag": "playground-postgres",
    "commit_message": "Gatus playground + Postgres 17 stack - durable history, one-touch startup of the playground config."
  }
}

docs {
  ## Gatus playground + Postgres — `playground-postgres`
  
  One-touch durable version of the **playground** tag: a `db` (Postgres 17) member plus a gatus
  `app` member running the same example endpoints + httpbin token-reuse suite, but with
  `storage.type: postgres` so check history survives `app` restarts/upgrades.
  
  ### Wiring (same pattern as gatus v5.36.0-postgres)
  - Shared password `PG_PASSWORD` = `${pods:random:32}`, generated once on the stack row.
  - `app` reaches the db via `GATUS_DB_HOST = ${stack:db:host}` (in-cluster DNS). `compile_member_stack_refs`
    only walks env vars + secret_map, so the DSN is assembled from `GATUS_DB_*` env by gatus's own
    `${VAR}` expansion — the resolved password never lands in the rendered config.
  - key=value DSN (`password='...'`) tolerates the `@ # %` chars `${pods:random:32}` can emit.
  
  ### Ordering / networking
  `ordered` + `depends_on: ["db"]` + `ready_condition: ready` ⇒ gatus starts only after
  `pg_isready` passes. `db` is `local_only` (never routed by Traefik); only `app` gets a public,
  tapis_auth'd URL.
  
  ### Full durability (survive db pod recreation too)
  The db filesystem is ephemeral. To persist across db recreation, add a tapisvolume to the db member:
  
  ```json
  "volume_mounts": {
    "/var/lib/postgresql/data": { "type": "tapisvolume", "source_id": "${:?Tapis volume for Postgres data}" }
  }
  ```
}
