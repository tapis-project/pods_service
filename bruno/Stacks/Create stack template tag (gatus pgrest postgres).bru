meta {
  name: tag: gatus pgrest postgres (stack)
  type: http
  seq: 23
}

post {
  url: {{base_url}}/pods/templates/gatus/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
  "kind": "stack",
  "stack_definition": {
    "restart_policy": "ordered",
    "secret_map": {
      "PG_PASSWORD": "${pods:random:32}",
      "BASE_URL": "${:?tacc-side tenant base URL, no trailing slash, e.g. https://tacc.develop.tapis.io - used for the tacc PgREST set, the Actors watch, and the tacc token mint}",
      "TAPIS_USERNAME": "${:?Tapis username (same account works in both tenants) - used to mint tokens in-suite via password grant}",
      "TAPIS_PASSWORD": "${:?Tapis password - used only to mint tokens in-suite (clientless password grant); stored write-only}"
    },
    "members": [
      {
        "name": "db",
        "image": "postgres:17-alpine",
        "description": "Postgres 17 for gatus check history. Persistent - backed by a Tapis volume. local_only, never exposed outside the cluster.",
        "ready_condition": "ready",
        "time_to_stop_default": -1,
        "networking": {
          "default": {
            "protocol": "local_only",
            "port": 5432,
            "tapis_auth": false
          }
        },
        "healthchecks": {
          "readiness": {
            "tcp_socket_port": 5432,
            "initial_delay_seconds": 5,
            "period_seconds": 5,
            "failure_threshold": 40
          },
          "liveness": {
            "exec_command": [
              "pg_isready",
              "-U",
              "gatus",
              "-d",
              "gatus"
            ],
            "initial_delay_seconds": 45,
            "period_seconds": 15
          },
          "networking_requires_ready": false
        },
        "environment_variables": {
          "POSTGRES_DB": "gatus",
          "POSTGRES_USER": "gatus",
          "POSTGRES_PASSWORD": "${stack:secrets:PG_PASSWORD}",
          "PGDATA": "/var/lib/postgresql/data/pgdata"
        },
        "volume_mounts": {
          "/var/lib/postgresql/data": {
            "type": "tapisvolume",
            "source_id": "${:?Tapis volume for Postgres data - makes check history survive db pod recreation}"
          }
        },
        "resources": {
          "cpu_request": 250,
          "cpu_limit": 2000,
          "mem_request": 256,
          "mem_limit": 2048
        }
      },
      {
        "name": "app",
        "image": "twinproduction/gatus:v5.36.0",
        "description": "Gatus v5.36.0 monitoring Tapis PgREST, with postgres storage - check history survives app restarts.",
        "depends_on": [
          "db"
        ],
        "time_to_stop_default": -1,
        "environment_variables": {
          "GATUS_DB_HOST": "${stack:db:host}",
          "GATUS_DB_PORT": "5432",
          "GATUS_DB_USER": "gatus",
          "GATUS_DB_NAME": "gatus",
          "GATUS_DB_PASSWORD": "${stack:secrets:PG_PASSWORD}",
          "BASE_URL": "${stack:secrets:BASE_URL}",
          "TAPIS_USERNAME": "${stack:secrets:TAPIS_USERNAME}",
          "TAPIS_PASSWORD": "${stack:secrets:TAPIS_PASSWORD}",
          "TAPIS_DISPLAY": "${pods:default:Tapis:?short label for the page title, e.g. TACC Dev}"
        },
        "volume_mounts": {
          "/config/config.yaml": {
            "type": "ephemeral",
            "read_only": false,
            "config_permissions": "0644",
            "config_update_mode": "always",
            "config_content": "# Tapis PgREST + Abaco status board (gatus + postgres, persistent).\n# Tokens are minted IN-SUITE via clientless password grant (username/password)\n# per tenant - no static JWT is stored. Each suite mints first (stored as\n# [CONTEXT].token) then runs its checks. tacc token -> tacc PgREST + Actors;\n# a2cps token -> a2cps PgREST. ${VAR} is gatus env expansion from pod env.\nstorage:\n  type: postgres\n  path: \"host=${GATUS_DB_HOST} port=${GATUS_DB_PORT} user=${GATUS_DB_USER} password='${GATUS_DB_PASSWORD}' dbname=${GATUS_DB_NAME} sslmode=disable\"\n  maximum-number-of-results: 12000\n  maximum-number-of-events: 1000\n\nweb:\n  port: 8080\n\nui:\n  title: \"Tapis Status | ${TAPIS_DISPLAY}\"\n  header: \"Tapis PgREST + Abaco Status\"\n\nsuites:\n  - name: PgREST\n    group: PgREST\n    interval: 60s\n    timeout: 30s\n    endpoints:\n      - name: Mint tacc token\n        url: \"${BASE_URL}/v3/oauth2/tokens\"\n        method: POST\n        headers:\n          Content-Type: \"application/json\"\n        body: |\n          {\"username\": \"${TAPIS_USERNAME}\", \"password\": \"${TAPIS_PASSWORD}\", \"grant_type\": \"password\"}\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"len([BODY].result.access_token.access_token) > 0\"\n        store:\n          token: \"[BODY].result.access_token.access_token\"\n      - name: PgREST Reachable\n        url: \"${BASE_URL}/v3/pgrest/manage/tables\"\n        conditions:\n          - \"[STATUS] == any(200, 401, 403)\"\n          - \"[RESPONSE_TIME] < 2000\"\n      - name: PgREST Tables List\n        url: \"${BASE_URL}/v3/pgrest/manage/tables\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n      - name: PgREST Views List\n        url: \"${BASE_URL}/v3/pgrest/manage/views\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n      - name: PgREST Roles List\n        url: \"${BASE_URL}/v3/pgrest/manage/roles\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n  - name: PgREST (a2cps)\n    group: PgREST (a2cps)\n    interval: 60s\n    timeout: 30s\n    endpoints:\n      - name: Mint a2cps token\n        url: \"https://a2cps.tapis.io/v3/oauth2/tokens\"\n        method: POST\n        headers:\n          Content-Type: \"application/json\"\n        body: |\n          {\"username\": \"${TAPIS_USERNAME}\", \"password\": \"${TAPIS_PASSWORD}\", \"grant_type\": \"password\"}\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"len([BODY].result.access_token.access_token) > 0\"\n        store:\n          token: \"[BODY].result.access_token.access_token\"\n      - name: PgREST Reachable\n        url: \"https://a2cps.tapis.io/v3/pgrest/manage/tables\"\n        conditions:\n          - \"[STATUS] == any(200, 401, 403)\"\n          - \"[RESPONSE_TIME] < 2000\"\n      - name: PgREST Tables List\n        url: \"https://a2cps.tapis.io/v3/pgrest/manage/tables\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n      - name: PgREST Views List\n        url: \"https://a2cps.tapis.io/v3/pgrest/manage/views\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n      - name: PgREST Roles List\n        url: \"https://a2cps.tapis.io/v3/pgrest/manage/roles\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n  - name: Actors\n    group: Actors\n    interval: 3m\n    timeout: 30s\n    endpoints:\n      - name: Mint tacc token\n        url: \"${BASE_URL}/v3/oauth2/tokens\"\n        method: POST\n        headers:\n          Content-Type: \"application/json\"\n        body: |\n          {\"username\": \"${TAPIS_USERNAME}\", \"password\": \"${TAPIS_PASSWORD}\", \"grant_type\": \"password\"}\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"len([BODY].result.access_token.access_token) > 0\"\n        store:\n          token: \"[BODY].result.access_token.access_token\"\n      - name: List Actors\n        url: \"${BASE_URL}/v3/actors\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n          - \"[RESPONSE_TIME] < 2000\"\n      - name: List Actors Paged\n        url: \"${BASE_URL}/v3/actors?limit=5\"\n        headers:\n          X-Tapis-Token: \"[CONTEXT].token\"\n        conditions:\n          - \"[STATUS] == 200\"\n          - \"[BODY].status == success\"\n"
          }
        },
        "networking": {
          "default": {
            "protocol": "http",
            "port": 8080,
            "tapis_auth": true,
            "tapis_auth_allowed_users": [
              "*"
            ],
            "tapis_auth_return_path": "/"
          }
        },
        "healthchecks": {
          "readiness": {
            "http_get_path": "/health",
            "http_get_port": 8080,
            "initial_delay_seconds": 5,
            "period_seconds": 10
          },
          "liveness": {
            "http_get_path": "/health",
            "http_get_port": 8080,
            "initial_delay_seconds": 30,
            "period_seconds": 15
          },
          "networking_requires_ready": true
        }
      }
    ]
  },
  "tag": "pgrest-postgres",
  "commit_message": "Gatus v5.36 + Postgres 17: PgREST (tacc + a2cps) & Abaco Actors board. In-suite clientless token minting (username/password) per tenant - no static JWT. 3 banners, ~1wk retention, tcp db readiness."
}
}

docs {
  ## Gatus + Postgres stack monitoring PgREST - `pgrest-postgres`
  
  Same shape as `gatus postgres` / `gatus tapis postgres`, specialized to the Tapis PgREST
  API (the OpenAPI you handed me), and made fully persistent.
  
  ### The checks (from the PgREST spec)
  | check | endpoint | auth | condition |
  |-------|----------|------|-----------|
  | PgREST Reachable | GET /v3/pgrest/manage/tables | none | `[STATUS] == any(200, 401, 403)` |
  | Tables List | GET /v3/pgrest/manage/tables (list_tables) | JWT | `200` + `[BODY].status == success` |
  | Views List  | GET /v3/pgrest/manage/views  (list_views)  | JWT | `200` + `[BODY].status == success` |
  | Roles List  | GET /v3/pgrest/manage/roles  (list_roles)  | JWT | `200` + `[BODY].status == success` |
  
  - **PgREST Reachable** is the JWT-free liveness signal: an unauthenticated call to a
    protected list endpoint returns 200 or 401 - either proves the service is up and its auth
    layer is answering. This one stays green even when the JWT expires.
  - The three **List** checks send `X-Tapis-Token: ${pods:secrets:JWT}` and assert both the
    HTTP 200 AND the PgREST envelope (`BasicResponse.status == "success"`), so a 200 with an
    error body still trips red.
  - list_tables needs PGREST_ADMIN; list_roles needs PGREST_ROLE_ADMIN - so the JWT must
    carry both. `[RESPONSE_TIME] < 2000` on the reachability check catches slow-but-up.
  
  ### Watch a specific data table too (optional)
  PgREST data rows live under `/v3/pgrest/data/{root_url}`. To monitor one, add an endpoint:
  ```yaml
  - name: Widgets Rows ${pods:secrets:DISPLAY}
    group: Data
    url: ${pods:secrets:BASE_URL}/v3/pgrest/data/widgets
    interval: 300s
    headers: { X-Tapis-Token: ${pods:secrets:JWT} }
    conditions: [ "[STATUS] == 200" ]
  ```
  (root_url is per-deployment, so it's not baked into the shared template.)
  
  ### Persistence (both the "persistent" ask + the base stack's open TODO)
  - `app` is stateless: history is in postgres, so restarting/upgrading it loses nothing.
  - `db` now mounts a **Tapis volume** at `/var/lib/postgresql/data` (PGDATA points at the
    `pgdata` subdir, avoiding the lost+found init snag). Because it's a template, the mount
    uses the `${:?...}` placeholder form - instantiation prompts for the volume id. That
    closes the "db filesystem is still ephemeral" caveat the base `gatus postgres` tag calls
    out: check history now survives db pod recreation too.
  
  ### How the two families of placeholders in config_content resolve
  `compile_member_stack_refs` only walks a member's `environment_variables` / `secret_map` -
  NOT its config_content. So:
  - **DB wiring** (`${stack:db:host}`, PG password) goes through `GATUS_DB_*` env vars, and
    gatus's own `${VAR}` expansion threads them into `storage.path` at startup. This also keeps
    the resolved password out of the rendered ConfigMap.
  - **`${pods:secrets:BASE_URL|JWT|DISPLAY}` in config_content** is filled by
    `interpolate_config_content` from the POD's secret_map. That only works because the `app`
    member declares its OWN `secret_map` wiring `BASE_URL`/`JWT` to the stack secrets
    (`${stack:secrets:...}`) and `DISPLAY` to a `${pods:default:Tapis:?...}`.
  ⚠ Omit that member secret_map and the pod has no BASE_URL/JWT/DISPLAY, so
  `${pods:secrets:BASE_URL}` interpolates to empty - the endpoint url becomes `/v3/pgrest/...`
  and gatus panics at boot with `unknown endpoint type`. (That was the first-cut bug here.)
  
  ### Heads-up on the JWT
  When the token in `JWT` expires the three authed List checks flip red (401) even if PgREST
  is healthy - the **PgREST Reachable** check is there precisely so the board still shows the
  service as up. Rotate the stack secret to refresh the authed checks.
  
  ### Ordering / networking
  `restart_policy: ordered` + `depends_on: ["db"]` + `ready_condition: ready` ⇒ gatus starts
  only after `db` readiness passes. `db` is `local_only` (in-cluster only via
  `${stack:db:host}`); only `app` gets a public, tapis_auth'd URL gated behind `/health`.
  
  **Why `db` readiness is a TCP-socket probe, not `pg_isready`** (fixes a boot panic:
  `dial tcp …:5432: connect: connection refused` in gatus `initializeStorage`). On a fresh
  volume postgres runs `initdb` first, and the official image's temporary init server listens
  on the **unix socket only** (`listen_addresses=''`, no TCP). `pg_isready` talks to that local
  socket, so it reports **ready** while the real TCP listener is still down — `ready_condition`
  then releases gatus, which dials `${stack:db:host}:5432`, gets **connection refused**, and
  panics (gatus connects to storage once at boot and does not retry). A `tcp_socket_port: 5432`
  readiness probe hits the pod IP on 5432 — the same path gatus uses — so it only passes once
  postgres accepts real connections, closing the initdb window. `failure_threshold: 40 × 5s`
  gives a cold-volume initdb ~3.3 min of runway. `pg_isready` moves to **liveness** (restart a
  wedged db). The other `gatus … postgres` stack tags share the old `pg_isready`-readiness and
  can hit the same race on a cold volume — apply the same swap if they flake.
  
  > Set the `gatus` template up first (POST /pods/templates with template_id `gatus`), then
  > post this tag. Instantiate via **Create stack from template** (`template: "gatus:pgrest-postgres"`).
}
