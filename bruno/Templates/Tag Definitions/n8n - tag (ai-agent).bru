meta {
  name: tag: n8n (ai-agent)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/pods/templates/n8n/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
    "pod_definition": {
      "description": "n8n workflow automation - AI agent data extraction (Seth Sterling image)",
      "image": "ghcr.io/sethsterling22/ai_agent_for_data_extraction:main",
      "command": ["/bin/sh", "/startup.sh"],
      "secret_map": {
        "AI_TOKEN": "${:?AI inference API token - REQUIRED}"
      },
      "environment_variables": {
        "WEBHOOK_URL": "${:?Public URL for this pod - e.g. https://mypod.pods.tacc.tapis.io}",
        "JWT_AUTH_URL": "https://tacc.tapis.io/v3/oauth2/clients",
        "AI_CREDENTIALS": "${:?AI inference endpoint URL}",
        "AI_TOKEN": "${pods:secrets:AI_TOKEN}",
        "AI_MODEL": "${Llama-4-Maverick-17B-128E-Instruct:?AI model name - defaults to Llama-4-Maverick}"
      },
      "networking": {
        "default": {
          "protocol": "http",
          "port": 5678,
          "tapis_auth": false,
          "tapis_auth_allowed_users": ["*"]
        }
      },
      "resources": {
        "cpu_request": 250,
        "cpu_limit": 2000,
        "mem_request": 256,
        "mem_limit": 3072
      },
      "time_to_stop_default": -1
    },
    "tag": "ai-agent",
    "commit_message": "n8n AI agent workflow automation - Seth Sterling image"
  }
}
