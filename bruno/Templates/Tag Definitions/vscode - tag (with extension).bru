meta {
  name: tag: vscode (with extension)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/pods/templates/vscode/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
    "pod_definition": {
      "description": "VS Code with Python extension pre-installed via custom entrypoint",
      "image": "lscr.io/linuxserver/code-server",
      "command": [
        "/bin/bash",
        "-c",
        "code-server --install-extension ms-python.python --install-extension ms-toolsai.jupyter && exec /init"
      ],
      "environment_variables": {
        "PUID": "1000",
        "PGID": "1000",
        "TZ": "${Etc/UTC:?Timezone - e.g. America/Chicago}",
        "DEFAULT_WORKSPACE": "/config/workspace"
      },
      "networking": {
        "default": {
          "protocol": "http",
          "port": 8443,
          "tapis_auth": true,
          "tapis_auth_allowed_users": ["*"]
        }
      },
      "resources": {
        "cpu_request": 250,
        "cpu_limit": 2000,
        "mem_request": 512,
        "mem_limit": 4096
      },
      "time_to_stop_default": -1
    },
    "tag": "python-jupyter",
    "commit_message": "VS Code with Python + Jupyter extensions auto-installed at startup"
  }
}
