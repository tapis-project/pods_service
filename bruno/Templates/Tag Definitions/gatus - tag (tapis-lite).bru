meta {
  name: tag: gatus (tapis-lite)
  type: http
  seq: 20
}

post {
  url: {{base_url}}/pods/templates/gatus/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Tapis-Token: {{X-Tapis-Token}}
}

body:json {
  {
    "kind": "pod",
    "pod_definition": {
      "image": "twinproduction/gatus:v5.36.0",
      "description": "Lite Tapis status board - the 12 public checks from gatus:tapis (no JWT, no authn creds, no volume). In-memory storage: current status rebuilds within one poll interval after restart, but history is not persisted. Exactly one required field: BASE_URL.",
      "time_to_stop_default": -1,
      "secret_map": {
        "BASE_URL": "${:?Tapis tenant base URL used for every request, e.g. https://tacc.tapis.io}",
        "DISPLAY": "${pods:default:Tapis:?Tenant label appended to each check name, e.g. TACC}",
        "HEALTHCHECK_INTERVAL": "${pods:default:15s:?How often to poll /healthcheck endpoints (default 15s)}",
        "SERVICECHECK_INTERVAL": "${pods:default:60s:?How often to poll public list/ready endpoints (default 60s)}"
      },
      "volume_mounts": {
        "/config/config.yaml": {
          "type": "ephemeral",
          "read_only": false,
          "config_permissions": "0644",
          "config_filename": "config.yaml",
          "config_update_mode": "always",
          "config_content": "# Tapis status board (LITE) - public healthchecks only, rendered from tapis/status-config-builder for ONE tenant.\n# ${pods:secrets:KEY} placeholders are filled by the Pods service from secret_map at instantiation.\nstorage:\n  type: memory  # in-memory - current status rebuilds within one poll interval after restart; history not persisted\n\nweb:\n  port: 8080\n\nui:\n  title: Tapis Status | ${pods:secrets:DISPLAY}\n  header: Tapis Service Status\n\nendpoints:\n  - name: Systems HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/systems/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Systems\n  - name: Apps HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/apps/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Apps\n  - name: Jobs HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/jobs/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Jobs\n  - name: Notifications HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/notifications/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Notifications\n  - name: Files HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/files/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Files\n  - name: Meta HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/meta/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Meta\n  - name: SK HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/security/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Security Kernel\n  - name: Tenants List ${pods:secrets:DISPLAY}\n    group: Tenants\n    url: ${pods:secrets:BASE_URL}/v3/tenants\n    interval: ${pods:secrets:SERVICECHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n  - name: Tokens Ready ${pods:secrets:DISPLAY}\n    group: Tokens\n    url: ${pods:secrets:BASE_URL}/v3/tokens/ready\n    interval: ${pods:secrets:SERVICECHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n  - name: Streams Ready ${pods:secrets:DISPLAY}\n    group: Streams\n    url: ${pods:secrets:BASE_URL}/v3/streams/ready\n    interval: ${pods:secrets:SERVICECHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n  - name: Workflows HealthCheck ${pods:secrets:DISPLAY}\n    url: ${pods:secrets:BASE_URL}/v3/workflows/healthcheck\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n    group: Workflows\n  - name: Authenticator HealthCheck ${pods:secrets:DISPLAY}\n    group: Authenticator\n    url: ${pods:secrets:BASE_URL}/v3/oauth2/hello\n    interval: ${pods:secrets:HEALTHCHECK_INTERVAL}\n    conditions:\n      - \"[STATUS] == 200\"\n"
        }
      },
      "networking": {
        "default": {
          "protocol": "http",
          "port": 8080,
          "tapis_auth": true,
          "tapis_auth_allowed_users": [
            "*"
          ],
          "tapis_auth_return_path": "/",
          "tapis_ui_uri_redirect": true,
          "tapis_ui_uri_description": "Gatus - Tapis status board (lite, public checks only)"
        }
      },
      "healthchecks": {
        "readiness": {
          "http_get_path": "/health",
          "http_get_port": 8080,
          "initial_delay_seconds": 5,
          "period_seconds": 10
        },
        "liveness": {
          "http_get_path": "/health",
          "http_get_port": 8080,
          "initial_delay_seconds": 30,
          "period_seconds": 15
        },
        "networking_requires_ready": true
      },
      "resources": {
        "cpu_request": 100,
        "cpu_limit": 1000,
        "mem_request": 128,
        "mem_limit": 512
      }
    },
    "tag": "tapis-lite",
    "commit_message": "Lite Tapis status board - 12 public checks, one required field (BASE_URL). No JWT/authn/volume; in-memory storage (no history persistence).",
    "description": "Frictionless Tapis status board: the public healthcheck/ready subset of gatus:tapis. No JWT, no authn creds, no tapisvolume - just BASE_URL. In-memory storage means check history resets on restart (current status repopulates within one interval)."
  }
}

docs {
  ## Gatus Tapis status board (lite) — `tapis-lite`

  The low-friction sibling of `gatus:tapis`: **one required field** (`BASE_URL`) instead of
  five. Dropped relative to `tapis`:

  - **All 8 JWT-authed list checks** (Systems/Apps/Jobs/Notifications/Actors/Pods/Workflows
    lists + GlobusProxy) — no `JWT` secret, and no checks that flip red when a JWT expires.
  - **The Authenticator token-create check** — no `AUTHN_USERNAME`/`AUTHN_PASSWORD`.
  - **The /data tapisvolume** — storage is `type: memory` instead of SQLite (the scratch
    image has no writable dir, so SQLite *requires* a mounted volume).

  Kept: the 12 public checks — 9 service `/healthcheck`s (Systems, Apps, Jobs, Notifications,
  Files, Meta, SK, Workflows, Authenticator hello) + Tenants list, Tokens ready, Streams ready.

  ### What "no volume" costs you
  **No persistence of logged history** — uptime %, response-time history, and event timelines
  reset on every restart. The *current* red/green state is rebuilt automatically within one
  poll interval (15s/60s), so a status-glance board loses almost nothing. If you want history
  without a volume, use the `tapis-postgres` stack tag.

  ### Optional knobs (defaults apply if untouched)
  `DISPLAY` (default `Tapis`), `HEALTHCHECK_INTERVAL` (`15s`), `SERVICECHECK_INTERVAL` (`60s`).
  Note: `BASE_URL` must stay a required placeholder — `${pods:default:...}` default values
  cannot contain `:`, so a URL can't be a placeholder default.
}
