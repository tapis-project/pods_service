meta {
  name: Set template permission
  type: http
  seq: 12
}

post {
  url: {{base_url}}/pods/templates/{{template_id}}/permissions
  body: json
  auth: none
}

headers {
  X-Tapis-Token: {{X-Tapis-Token}}
  Content-Type: application/json
}

body:json {
  {
    "user": "**",
    "level": "READ"
  }
}
