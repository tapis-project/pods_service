meta {
  name: Set volume permission
  type: http
  seq: 8
}

post {
  url: {{base_url}}/pods/volumes/{{volume_id}}/permissions
  body: json
  auth: none
}

headers {
  X-Tapis-Token: {{X-Tapis-Token}}
  Content-Type: application/json
}

body:json {
  {
    "user": "someuser",
    "level": "READ"
  }
}
