# cp .env.example .env  then fill in. .env is gitignored — never commit it.
# DO NOT put real tokens/keys in this file — it IS committed.

# Tenant the MCP calls (tool calls go to {BASE}/v3/pods...)
TAPIS_BASE_URL=https://tacc.develop.tapis.io

# --- Auth: pick ONE ---
# (A) Manual token (simplest, expires in a few hours):
TAPIS_TOKEN=

# (B) Auto-refresh via a registered OAuth client (no manual tokens ever).
#     Create a client once: POST /v3/oauth2/clients -> base64(client_id:client_key).
#     When PASSWORD is set the bridge mints + refreshes its own token; TAPIS_TOKEN
#     is then ignored. /health shows "auth":"password-grant".
# TAPIS_CLIENT_BASIC=base64(client_id:client_key)
# TAPIS_USERNAME=
# TAPIS_PASSWORD=

# Diagnostic surface (opt-in): admin health/metrics, per-pod traffic/events,
# usage, all-resource permissions. 35 tools -> ~56. Off by default.
# MCP_VERBOSE=1

# --- optional LLM for /chat (omit => audit + overview work, chat disabled) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# LLM_BASE_URL=https://your-litellm.pods.tacc.develop.tapis.io/v1
# LLM_API_KEY=
# LLM_MODEL=claude-3-5-sonnet
